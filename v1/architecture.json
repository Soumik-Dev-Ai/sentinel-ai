    {"id": "msg_15", "from": "recovery", "to": "orchestrator", "y": 580, "label": "Strategy"},
    {"id": "msg_16", "from": "orchestrator", "to": "memory", "y": 610, "label": "memory.add()"},
    {"id": "msg_17", "from": "fastapi", "to": "browser", "y": 640, "label": "WebSocket events"}
  ]
}
